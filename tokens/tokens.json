{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "AxiomChess",
    "version": "0.1.0",
    "direction": "Ink and Felt -- precise, analytical, quiet confidence; chess-native, not SaaS-generic",
    "accentRole": "single emerald felt accent; never purple, never terracotta-cream artisan"
  },
  "typography": {
    "families": {
      "display": {
        "name": "Syne",
        "fallback": ["Segoe UI", "Helvetica Neue", "sans-serif"],
        "notes": "Geometric display face for brand and hero headlines. Never Inter, Roboto, Arial, or system-ui as the brand face."
      },
      "body": {
        "name": "IBM Plex Sans",
        "fallback": ["Segoe UI", "Helvetica Neue", "sans-serif"],
        "notes": "Readable analytical body and UI text."
      },
      "mono": {
        "name": "IBM Plex Mono",
        "fallback": ["Consolas", "Menlo", "monospace"],
        "notes": "Scores, CPL, move lists, and tabular data only."
      }
    },
    "maxFamilies": 2,
    "scale": {
      "xs": { "sizePx": 12, "lineHeight": 1.4, "letterSpacingEm": 0.01 },
      "sm": { "sizePx": 14, "lineHeight": 1.45, "letterSpacingEm": 0.005 },
      "md": { "sizePx": 16, "lineHeight": 1.5, "letterSpacingEm": 0 },
      "lg": { "sizePx": 20, "lineHeight": 1.35, "letterSpacingEm": -0.01 },
      "xl": { "sizePx": 28, "lineHeight": 1.2, "letterSpacingEm": -0.015 },
      "2xl": { "sizePx": 40, "lineHeight": 1.1, "letterSpacingEm": -0.02 },
      "3xl": { "sizePx": 56, "lineHeight": 1.05, "letterSpacingEm": -0.025 }
    },
    "measureCh": { "min": 45, "max": 75 }
  },
  "spacing": {
    "unitPx": 4,
    "scalePx": [4, 8, 12, 16, 24, 32, 48, 64, 96, 128]
  },
  "radius": {
    "none": 0,
    "sm": 2,
    "md": 4,
    "lg": 8,
    "notes": "Prefer small radii. No rounded-full pill clusters."
  },
  "elevation": {
    "strategy": "borders and one restrained shadow; no multi-layer glow stacks",
    "levels": {
      "flat": { "border": true, "shadow": "none" },
      "raised": {
        "border": true,
        "shadowLight": "0 1px 2px rgba(26, 36, 33, 0.08)",
        "shadowDark": "0 1px 2px rgba(0, 0, 0, 0.35)"
      }
    }
  },
  "motion": {
    "intentionalCount": 3,
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)",
    "durationsMs": {
      "fast": 160,
      "base": 280,
      "slow": 420
    },
    "signatures": [
      {
        "id": "brand-settle",
        "where": "landing hero",
        "desc": "Brand wordmark opacity and 4px Y settle on first paint"
      },
      {
        "id": "band-reveal",
        "where": "report entry",
        "desc": "Suspicion band bar width animates from 0 to score once"
      },
      {
        "id": "piece-place",
        "where": "board replay",
        "desc": "Active piece soft-drop 6px with short fade on ply advance"
      }
    ],
    "banned": ["noise loops", "gradient shimmer", "unsolicited confetti", "continuous glow pulse"]
  },
  "icons": {
    "set": "stroke",
    "strokeWidthPx": 1.5,
    "sizePx": [16, 20, 24],
    "emojiAsIcons": false
  },
  "color": {
    "rules": [
      "One accent only",
      "No pure #000000 for large fields",
      "Secondary text is tinted, not flat grey",
      "Light and dark via the same token names"
    ],
    "light": {
      "bg": "#F2F4F3",
      "surface": "#FFFFFF",
      "surfaceMuted": "#E8ECE9",
      "ink": "#1A2421",
      "inkSecondary": "#4A5C56",
      "inkTertiary": "#6B7F77",
      "border": "#C5CEC9",
      "borderStrong": "#8A9A92",
      "accent": "#0E7A5F",
      "accentHover": "#0A624C",
      "accentMuted": "#D4EDE4",
      "accentContrast": "#F2F4F3",
      "focus": "#0E7A5F",
      "danger": "#A33B2D",
      "warning": "#8A6A1F",
      "success": "#0E7A5F"
    },
    "dark": {
      "bg": "#121816",
      "surface": "#1C2420",
      "surfaceMuted": "#151C19",
      "ink": "#E6EDE9",
      "inkSecondary": "#9AABA3",
      "inkTertiary": "#6F8178",
      "border": "#2E3A34",
      "borderStrong": "#4A5C54",
      "accent": "#3DB892",
      "accentHover": "#5CC9A6",
      "accentMuted": "#1A3D32",
      "accentContrast": "#121816",
      "focus": "#3DB892",
      "danger": "#E07064",
      "warning": "#D4B44A",
      "success": "#3DB892"
    }
  },
  "board": {
    "specDoc": "docs/board-theme.md",
    "light": {
      "squareLight": "#D8DFD4",
      "squareDark": "#5A7264",
      "lastMove": "rgba(14, 122, 95, 0.35)",
      "selected": "#0E7A5F",
      "highlightCheck": "rgba(163, 59, 45, 0.40)",
      "coord": "#4A5C56"
    },
    "dark": {
      "squareLight": "#3A4A42",
      "squareDark": "#24302B",
      "lastMove": "rgba(61, 184, 146, 0.35)",
      "selected": "#3DB892",
      "highlightCheck": "rgba(224, 112, 100, 0.40)",
      "coord": "#9AABA3"
    }
  },
  "suspicionBands": {
    "note": "UI ordinal bands only; never a cheater label. Cut points from PROJECT_SPEC.md",
    "low": { "maxExclusive": 0.45, "tokenHint": "success/accentMuted" },
    "elevated": { "minInclusive": 0.45, "maxExclusive": 0.70, "tokenHint": "warning" },
    "high": { "minInclusive": 0.70, "tokenHint": "danger" },
    "inconclusive": { "tokenHint": "inkSecondary" }
  }
}
