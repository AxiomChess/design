{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axiomchess.github.io/design/tokens.schema.json",
  "title": "AxiomChessDesignTokens",
  "type": "object",
  "required": ["meta", "typography", "spacing", "color", "board", "motion", "elevation", "icons"],
  "properties": {
    "meta": { "type": "object" },
    "typography": { "type": "object" },
    "spacing": { "type": "object" },
    "radius": { "type": "object" },
    "elevation": { "type": "object" },
    "motion": { "type": "object" },
    "icons": { "type": "object" },
    "color": {
      "type": "object",
      "required": ["light", "dark"],
      "properties": {
        "light": { "$ref": "#/$defs/palette" },
        "dark": { "$ref": "#/$defs/palette" }
      }
    },
    "board": { "type": "object" },
    "suspicionBands": { "type": "object" }
  },
  "$defs": {
    "palette": {
      "type": "object",
      "required": [
        "bg",
        "surface",
        "ink",
        "inkSecondary",
        "border",
        "accent",
        "accentMuted",
        "focus"
      ],
      "additionalProperties": { "type": "string" }
    }
  }
}
